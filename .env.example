# База данных (SQLite, Prisma). Локально достаточно file:./db/custom.db
# На Vercel переменную задавать не нужно — база из репозитория автоматически
# копируется в /tmp (serverless, read-only ФС).
DATABASE_URL=file:./db/custom.db

# JWT secret для админ-панели (обязательно сменить в продакшене)
JWT_SECRET=your-secret-key-change-in-production

# SMTP — письма из формы контактов (необязательно: без них заявки
# сохраняются в базу, но не отправляются на почту)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
CONTACT_EMAIL=your-email@gmail.com

# Для Gmail:
# 1. Включить двухфакторную аутентификацию
# 2. Создать пароль приложения: https://myaccount.google.com/apppasswords
# 3. Использовать его как SMTP_PASS

# Cloudinary — загрузка изображений в админке (необязательно: без этих
# переменных файлы сохраняются локально в public/uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
